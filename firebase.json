{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "functions/**",
      "extension-src/**",
      ".claude/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/**",
        "function": "ai"
      }
    ]
  }
}
