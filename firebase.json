{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": [
    {
      "target": "psg",
      "public": "connector-site",
      "ignore": ["firebase.json", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/mcp",
          "function": "mcp"
        },
        {
          "source": "/api/mcp/**",
          "function": "mcp"
        },
        {
          "source": "/.well-known/oauth-protected-resource",
          "function": "mcp"
        },
        {
          "source": "/.well-known/oauth-protected-resource/**",
          "function": "mcp"
        }
      ]
    }
  ]
}
